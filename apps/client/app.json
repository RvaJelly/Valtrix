{
  "expo": {
    "name": "Voltrix",
    "slug": "voltrix",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "voltrix",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "bundleIdentifier": "com.voltrix.client",
      "supportsTablet": true
    },
    "android": {
      "package": "com.voltrix.client",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Voltrix to use Face ID to unlock the app."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Voltrix to use your photos so you can share stories, reels and chat photos and add a profile photo.",
          "cameraPermission": "Allow Voltrix to use your camera for video calls, chat photos, stories and reels.",
          "microphonePermission": "Allow Voltrix to use your microphone for voice and video calls and so your videos have sound."
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Voltrix to use your microphone for voice and video calls and so your videos have sound."
          }
        ],
        [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Voltrix to use your location to find trainers near you."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
